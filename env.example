# ============================================================
#  IBM Cloud / IBM Granite – Fitness Buddy Configuration
# ============================================================

# --- IBM Watson Machine Learning (WML) Credentials ---
# Obtain from: https://cloud.ibm.com/iam/apikeys
IBM_API_KEY=MSRATqEUgVVg4ZlXChwTnB6XXYSR4b1KmbKgguW-jVph

# IBM Cloud IAM Token URL (do not change)
IBM_IAM_URL=https://iam.cloud.ibm.com/identity/token

# IBM Watson Machine Learning endpoint for your region
# Dallas  : https://us-south.ml.cloud.ibm.com
# Frankfurt: https://eu-de.ml.cloud.ibm.com
# London  : https://eu-gb.ml.cloud.ibm.com
# Tokyo   : https://jp-tok.ml.cloud.ibm.com
IBM_WML_URL=https://us-south.ml.cloud.ibm.com

# IBM Cloud Project ID (from watsonx.ai project settings)
IBM_PROJECT_ID=b764144e-ada9-4eda-ae4b-9be3543dd609

# --- IBM Granite Model Selection ---
# Available models on IBM watsonx.ai (Lite tier, verified working):
#   ibm/granite-4-h-small             (recommended – instruct/chat capable)
#   ibm/granite-3-1-8b-base           (base generation model)
IBM_GRANITE_MODEL=ibm/granite-4-h-small

# --- Generation Parameters ---
MAX_NEW_TOKENS=800
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50
REPETITION_PENALTY=1.1

# --- App Server Settings ---
PORT=3000
NODE_ENV=development

# --- Rate Limiting ---
# Max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
